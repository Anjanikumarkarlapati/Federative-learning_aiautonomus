{
  "name": "centralized",
  "num_clients": 50,
  "seed": 1337,
  "device": "cpu",
  "workers": 0,
  "out_dir": "runs",
  "data": {
    "num_classes": 6,
    "image_size": 32,
    "traj_horizon": 6,
    "samples_per_client": 220,
    "quantity_skew": 0.45,
    "dirichlet_alpha": 0.4,
    "feature_skew": true,
    "train_share": 0.7,
    "val_share": 0.15,
    "test_share": 0.15,
    "global_test_size": 1800,
    "augment": true
  },
  "model": {
    "width": 1.0,
    "stem_channels": 24,
    "stage_channels": [
      32,
      64,
      128
    ],
    "embed_dim": 192,
    "dropout": 0.05,
    "box_dim": 4,
    "lambda_box": 1.0,
    "lambda_traj": 0.5,
    "max_parameters": 6000000
  },
  "train": {
    "rounds": 60,
    "local_epochs": 5,
    "adaptive_epochs": false,
    "min_epochs": 1,
    "max_epochs": 8,
    "lr": 0.01,
    "cosine_decay": true,
    "momentum": 0.9,
    "weight_decay": 0.0005,
    "batch_size": 32,
    "fedprox_mu": 0.0,
    "tolerance": 0.001,
    "target_accuracy": 0.9,
    "grad_clip": 5.0
  },
  "selection": {
    "fraction": 0.3,
    "uptime_threshold": 0.55,
    "trajectory_aware": true,
    "fairness_k": 12,
    "min_clients": 2,
    "round_timeout_s": 45.0,
    "seed_jitter": true
  },
  "aggregation": {
    "quality_aware": true,
    "normalize_local_steps": true,
    "server_momentum": 0.9,
    "byzantine_robust": false,
    "trim_fraction": 0.1,
    "q_min": 0.05,
    "q_max": 1.0
  },
  "dp": {
    "enabled": false,
    "clip_norm": 1.0,
    "epsilon": 8.0,
    "delta": 1e-05,
    "secure_aggregation": true
  },
  "comm": {
    "fp16": true,
    "gzip_level": 6,
    "send_deltas": true,
    "broadcast_delta": true,
    "multicast": true,
    "topk_ratio": 0.25,
    "error_feedback": true,
    "min_topk_ratio": 0.02,
    "adaptive_sparsity": true,
    "mb_budget_per_round": 9.0
  }
}